# syntax=docker/dockerfile:1

# --- API image ---------------------------------------------------------------
FROM python:3.13-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv

WORKDIR /workspace

RUN addgroup --system --gid 10001 app \
    && adduser --system --uid 10001 --ingroup app --home /workspace app

# Dependency layer first for better cache reuse.
COPY pyproject.toml /workspace/pyproject.toml
COPY apps/api/pyproject.toml /workspace/apps/api/pyproject.toml
COPY packages/data_connectors/pyproject.toml /workspace/packages/data_connectors/pyproject.toml
COPY uv.lock /workspace/uv.lock
RUN uv sync --frozen --no-install-workspace --no-dev --all-packages

# Application sources.
COPY apps/api /workspace/apps/api
COPY packages/data_connectors /workspace/packages/data_connectors
RUN uv sync --frozen --no-dev --all-packages

RUN mkdir -p /data/storage && chown -R app:app /data /workspace

USER app
WORKDIR /workspace/apps/api

ENV PATH="/opt/venv/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "datosabiertos.main:app", "--host", "0.0.0.0", "--port", "8000"]
