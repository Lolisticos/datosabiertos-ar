# Copy to .env and adjust for local development. Never commit the real .env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=datosabiertos
POSTGRES_PASSWORD=datosabiertos
POSTGRES_DB=datosabiertos
POSTGRES_PORT=55437

# --- API --------------------------------------------------------------------
API_PORT=8008
DATOSABIERTOS_ENVIRONMENT=development
DATOSABIERTOS_LOG_LEVEL=INFO
DATOSABIERTOS_DATABASE_URL=postgresql+psycopg://datosabiertos:datosabiertos@localhost:55437/datosabiertos
DATOSABIERTOS_CORS_ORIGINS=http://localhost:3100
DATOSABIERTOS_STORAGE_ROOT=./data/storage
DATOSABIERTOS_INGESTION_USER_AGENT=DatosAbiertosAR/0.1 (+https://github.com/Lolisticos/datosabiertos-ar)
DATOSABIERTOS_INGESTION_MAX_DOWNLOAD_BYTES=52428800
DATOSABIERTOS_INGESTION_REQUEST_TIMEOUT_SECONDS=30

# Dedicated database for integration tests (must exist with PostGIS available).
DATOSABIERTOS_TEST_DATABASE_URL=postgresql+psycopg://datosabiertos:datosabiertos@localhost:55437/datosabiertos_test

# --- Web --------------------------------------------------------------------
WEB_PORT=3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8008
